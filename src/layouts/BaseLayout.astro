---
import '../styles/global.css';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description = SITE_DESCRIPTION, fullWidth = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/posts', label: 'Posts' },
  { href: '/tags', label: 'Tags' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme =
          stored === 'ue-dark' || stored === 'ue-light'
            ? stored
            : prefersDark
              ? 'ue-dark'
              : 'ue-light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content antialiased">
    <header class="border-b border-base-300/80 bg-base-100/85 backdrop-blur-md sticky top-0 z-30">
      <div class="navbar container mx-auto max-w-4xl px-4 sm:px-6">
        <div class="flex-1">
          <a href="/" class="btn btn-ghost text-lg font-extrabold tracking-tight px-2">
            {SITE_TITLE}
          </a>
        </div>
        <nav class="flex items-center gap-1" aria-label="주 메뉴">
          {
            navLinks.map(({ href, label }) => {
              const isActive = pathname === href || pathname.startsWith(`${href}/`);
              return (
                <a
                  href={href}
                  class:list={['btn btn-ghost btn-sm font-medium', isActive && 'btn-active text-primary']}
                >
                  {label}
                </a>
              );
            })
          }
          <button
            id="theme-toggle"
            type="button"
            class="btn btn-ghost btn-sm btn-square ml-1"
            aria-label="테마 전환"
            title="라이트/다크 테마 전환"
          >
            <svg
              id="icon-sun"
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
              ></path>
            </svg>
            <svg
              id="icon-moon"
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main
      class:list={[
        'flex-1 px-4 sm:px-6 py-10 sm:py-14',
        fullWidth ? 'w-full' : 'container mx-auto max-w-4xl',
      ]}
    >
      <slot />
    </main>

    <footer class="border-t border-base-300/80 mt-16">
      <div
        class="footer sm:footer-horizontal items-center container mx-auto max-w-4xl px-4 sm:px-6 py-6 text-sm text-base-content/65"
      >
        <aside>
          <p>© {new Date().getFullYear()} {SITE_TITLE}. Built with Astro & daisyUI.</p>
        </aside>
        <nav class="flex gap-4 sm:justify-self-end">
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="link link-hover">
            GitHub
          </a>
          <a href="/rss.xml" class="link link-hover">RSS</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

        function syncIcons() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'ue-dark';
          sun?.classList.toggle('hidden', !isDark);
          moon?.classList.toggle('hidden', isDark);
        }

        syncIcons();

        mediaQuery.addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) {
            document.documentElement.setAttribute('data-theme', e.matches ? 'ue-dark' : 'ue-light');
            syncIcons();
          }
        });

        btn?.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme');
          const next = current === 'ue-dark' ? 'ue-light' : 'ue-dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          syncIcons();
        });
      })();
    </script>
  </body>
</html>
