---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, type Post } from '../../utils/posts';

const posts = await getPublishedPosts();
const tagMap = new Map<string, Post[]>();

for (const post of posts) {
  for (const tag of post.data.tags) {
    const list = tagMap.get(tag) ?? [];
    list.push(post);
    tagMap.set(tag, list);
  }
}

const sortedTags = [...tagMap.entries()].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0])
);
---

<BaseLayout title="Tags" description="태그별 글 모아보기">
  <header class="mb-8 flex items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold mb-1">Tags</h1>
      <p class="text-base-content/70">총 {sortedTags.length}개의 태그</p>
    </div>
    <a href="/posts" class="btn btn-ghost btn-sm">← 모든 글</a>
  </header>

  {
    sortedTags.length === 0 ? (
      <div class="alert">
        <span>등록된 태그가 없습니다.</span>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {sortedTags.map(([tag, tagPosts]) => {
          const latest = tagPosts[0];
          return (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="card bg-base-200/70 border border-base-300 hover:border-primary/60 transition-colors group"
            >
              <div class="card-body gap-2.5 p-5 sm:p-6">
                <div class="flex items-center justify-between gap-2 text-xs text-base-content/60">
                  <span class="badge badge-xs badge-primary badge-soft font-semibold">
                    {tagPosts.length}개의 글
                  </span>
                  {latest && (
                    <time datetime={latest.data.pubDate.toISOString()}>
                      {formatDate(latest.data.pubDate)}
                    </time>
                  )}
                </div>
                <h2 class="card-title text-xl font-bold tracking-tight group-hover:text-primary transition-colors">
                  #{tag}
                </h2>
                {latest && (
                  <p class="text-sm text-base-content/75 leading-relaxed line-clamp-1">
                    최근 글: {latest.data.title}
                  </p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )
  }
</BaseLayout>
