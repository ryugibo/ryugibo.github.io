---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'rail' | 'inline';
}

const { headings, variant = 'rail' } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 && variant === 'inline' && (
    <details class="collapse collapse-arrow bg-base-200/70 border border-base-300 mb-8 xl:hidden">
      <summary class="collapse-title text-sm font-semibold py-3 min-h-0">
        On this page ({tocHeadings.length})
      </summary>
      <div class="collapse-content pt-0 pb-4">
        <ul class="space-y-1.5 text-sm border-l border-base-300 pl-3">
          {tocHeadings.map((heading) => (
            <li class:list={[heading.depth === 3 && 'pl-3']}>
              <a
                href={`#${heading.slug}`}
                class="block py-0.5 text-base-content/75 hover:text-primary transition-colors leading-snug"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
  )
}

{
  tocHeadings.length > 0 && variant === 'rail' && (
    <aside
      class="hidden xl:block xl:sticky xl:top-24 xl:self-start justify-self-end w-56 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2"
      aria-label="목차"
    >
      <div class="border-l border-base-300 pl-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-base-content/50 mb-3">
          On this page
        </p>
        <ul class="space-y-1.5 text-sm" id="toc-list">
          {tocHeadings.map((heading) => (
            <li class:list={[heading.depth === 3 && 'pl-3']}>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class="block py-0.5 text-base-content/65 hover:text-primary transition-colors leading-snug"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

{
  tocHeadings.length > 0 && variant === 'rail' && (
    <script is:inline>
      (() => {
        const links = Array.from(document.querySelectorAll('[data-toc-link]'));
        if (links.length === 0) return;

        const headingEls = links
          .map((link) => document.getElementById(link.getAttribute('data-toc-link') || ''))
          .filter(Boolean);

        function setActive(slug) {
          links.forEach((link) => {
            const active = link.getAttribute('data-toc-link') === slug;
            link.classList.toggle('text-primary', active);
            link.classList.toggle('font-semibold', active);
            link.classList.toggle('text-base-content/65', !active);
          });
        }

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.find((entry) => entry.isIntersecting);
            if (visible?.target?.id) {
              setActive(visible.target.id);
            }
          },
          { rootMargin: '-96px 0px -65% 0px', threshold: 0.1 }
        );

        headingEls.forEach((el) => observer.observe(el));
        if (headingEls[0]?.id) setActive(headingEls[0].id);
      })();
    </script>
  )
}
