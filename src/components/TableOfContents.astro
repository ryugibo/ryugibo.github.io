---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  tocHeadings.length > 0 && (
    <aside class="hidden lg:block" aria-label="목차">
      <div class="sticky top-24 border-l border-base-300 pl-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-base-content/50 mb-3">
          On this page
        </p>
        <ul class="space-y-1.5 text-sm" id="toc-list">
          {tocHeadings.map((heading) => (
            <li class:list={[heading.depth === 3 && 'pl-3']}>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class="block py-0.5 text-base-content/65 hover:text-primary transition-colors leading-snug"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )
}

<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll('[data-toc-link]'));
    if (links.length === 0) return;

    const headingEls = links
      .map((link) => document.getElementById(link.getAttribute('data-toc-link') || ''))
      .filter(Boolean);

    function setActive(slug) {
      links.forEach((link) => {
        const active = link.getAttribute('data-toc-link') === slug;
        link.classList.toggle('text-primary', active);
        link.classList.toggle('font-semibold', active);
        link.classList.toggle('text-base-content/65', !active);
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (visible?.target?.id) {
          setActive(visible.target.id);
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0.1 }
    );

    headingEls.forEach((el) => observer.observe(el));
    if (headingEls[0]?.id) setActive(headingEls[0].id);
  })();
</script>
