---
import { formatDate, getReadingTime, type Post } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, category, tags } = post.data;
const readingTime = getReadingTime(post.body);
---

<article
  class="card bg-base-200/70 border border-base-300 hover:border-primary/60 transition-colors"
>
  <div class="card-body gap-2.5 p-5 sm:p-6">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-base-content/60">
      <div class="flex items-center gap-2">
        {
          category && (
            <span class="badge badge-xs badge-primary badge-soft font-semibold uppercase tracking-wide">
              {category}
            </span>
          )
        }
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>·</span>
        <span>{readingTime}분 읽기</span>
      </div>
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <a
                href={`/tags/${encodeURIComponent(tag)}`}
                class="badge badge-sm badge-ghost hover:badge-primary transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <h2 class="card-title text-xl font-bold tracking-tight">
      <a href={`/posts/${post.id}`} class="link link-hover">
        {title}
      </a>
    </h2>
    <p class="text-sm text-base-content/75 leading-relaxed">{description}</p>
  </div>
</article>
